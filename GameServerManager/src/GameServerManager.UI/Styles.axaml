<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <Styles.Resources>
        <Color x:Key="BackgroundColor">#0E131F</Color>
        <Color x:Key="SidebarColor">#080B10</Color>
        <Color x:Key="SurfaceColor">#1A1F2E</Color>
        <Color x:Key="AccentColor">#3B82F6</Color>
        <Color x:Key="TextColor">#FFFFFF</Color>
        <Color x:Key="SecondaryTextColor">#9CA3AF</Color>
    </Styles.Resources>

    <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml"/>

    <Style Selector="Window">
        <Setter Property="Background" Value="{StaticResource BackgroundColor}"/>
        <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
    </Style>

    <!-- Navigation Buttons -->
    <Style Selector="Button.nav">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource SecondaryTextColor}"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="Padding" Value="10"/>
    </Style>
    <Style Selector="Button.nav:pointerover">
        <Setter Property="Background" Value="{StaticResource SurfaceColor}"/>
        <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
    </Style>

    <!-- Action Buttons -->
    <Style Selector="Button.action">
        <Setter Property="Background" Value="{StaticResource SurfaceColor}"/>
        <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
        <Setter Property="Padding" Value="8,4"/>
    </Style>
    <Style Selector="Button.action:pointerover">
        <Setter Property="Background" Value="{StaticResource AccentColor}"/>
    </Style>

    <!-- Start Action Button (Noble Matte Deep Green) -->
    <Style Selector="Button.action-start">
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="#064E3B"
                        BorderBrush="#047857"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="6,4"
                        Width="75"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      TextElement.Foreground="#ECFDF5"
                                      FontWeight="SemiBold"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Button.action-start:pointerover">
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="#0D5C46"
                        BorderBrush="#34D399"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="6,4"
                        Width="75"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      TextElement.Foreground="#FFFFFF"
                                      FontWeight="SemiBold"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Button.action-start:pressed">
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="#022C22"
                        BorderBrush="#059669"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="6,4"
                        Width="75"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      TextElement.Foreground="#A7F3D0"
                                      FontWeight="SemiBold"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- Stop Action Button (Noble Matte Deep Navy/Indigo) -->
    <Style Selector="Button.action-stop">
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="#1E3A8A"
                        BorderBrush="#1D4ED8"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="6,4"
                        Width="75"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      TextElement.Foreground="#EFF6FF"
                                      FontWeight="SemiBold"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Button.action-stop:pointerover">
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="#1E40AF"
                        BorderBrush="#60A5FA"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="6,4"
                        Width="75"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      TextElement.Foreground="#FFFFFF"
                                      FontWeight="SemiBold"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Button.action-stop:pressed">
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="#111827"
                        BorderBrush="#2563EB"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="6,4"
                        Width="75"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      TextElement.Foreground="#BFDBFE"
                                      FontWeight="SemiBold"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- Delete Action Button (Noble Matte Bordeaux/Wine) -->
    <Style Selector="Button.action-delete">
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="#7F1D1D"
                        BorderBrush="#991B1B"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="6,4"
                        Width="75"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      TextElement.Foreground="#FEF2F2"
                                      FontWeight="SemiBold"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Button.action-delete:pointerover">
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="#991B1B"
                        BorderBrush="#F87171"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="6,4"
                        Width="75"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      TextElement.Foreground="#FFFFFF"
                                      FontWeight="SemiBold"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Button.action-delete:pressed">
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="#450A0A"
                        BorderBrush="#DC2626"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="6,4"
                        Width="75"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      TextElement.Foreground="#FECACA"
                                      FontWeight="SemiBold"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- Primary Button -->
    <Style Selector="Button.primary">
        <Setter Property="Background" Value="{StaticResource AccentColor}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Padding" Value="15,8"/>
    </Style>

    <!-- DataGrid Row Styling -->
    <Style Selector="DataGridRow">
        <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="DataGridRow:pointerover /template/ Rectangle#BackgroundBorder">
        <Setter Property="Fill" Value="#1F2937"/>
    </Style>
    <Style Selector="DataGridRow:selected /template/ Rectangle#BackgroundBorder">
        <Setter Property="Fill" Value="#2563EB"/>
    </Style>
    <Style Selector="DataGridCell:focus-within">
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
</Styles>
