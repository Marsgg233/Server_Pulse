    "name": "ServerPulse",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5056",
      "type": "string"
    },
    {
      "key": "containerId",
      "value": "test-container-id-placeholder",
      "type": "string"
    },
    {
      "key": "imageId",
      "value": "test-image-id-placeholder",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Управление контейнерами",
      "item": [
        {
          "name": "Получить список всех контейнеров",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/servers",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "servers"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Статус код равен 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Время отклика меньше 500мс\", function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(500);",
                  "});",
                  "",
                  "pm.test(\"Ответ является массивом\", function () {",
                  "    let jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.be.an('array');",
                  "});",
                  "",
                  "pm.test(\"Заголовок Content-Type содержит application/json\", function () {",
                  "    pm.response.to.have.header(\"Content-Type\");",
                  "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
                  "});",
                  "",
                  "pm.test(\"Структура элементов контейнера корректна\", function () {",
                  "    let jsonData = pm.response.json();",
                  "    if (jsonData.length > 0) {",
                  "        let container = jsonData[0];",
                  "        pm.expect(container).to.have.property('id');",
                  "        pm.expect(container).to.have.property('image');",
                  "        pm.expect(container).to.have.property('state');",
                  "    }",
                  "});",
                  "",
                  "pm.test(\"Тело ответа не пустое\", function () {",
                  "    pm.expect(pm.response.text()).to.not.be.empty;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Запуск нового контейнера (Успешно)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"imageName\": \"nginx:latest\",\n  \"containerName\": \"test-server-nginx\",\n  \"port\": 8080\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/servers/start",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "servers",
                "start"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Статус код равен 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Время отклика приемлемое (< 3000мс)\", function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(10000);",
                  "});",
                  "",
                  "pm.test(\"Ответ содержит идентификатор контейнера (id)\", function () {",
                  "    let jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('id');",
                  "    pm.expect(jsonData.id).to.be.a('string');",
                  "    pm.expect(jsonData.id).to.not.be.empty;",
                  "    pm.collectionVariables.set(\"containerId\", jsonData.id);",
                  "});",
                  "",
                  "pm.test(\"Идентификатор успешно сохранен в переменную коллекции\", function () {",
                  "    let savedId = pm.collectionVariables.get(\"containerId\");",
                  "    pm.expect(savedId).to.not.be.empty;",
                  "    pm.expect(savedId).to.not.eql(\"test-container-id-placeholder\");",
                  "});",
                  "",
                  "pm.test(\"Заголовок Content-Type корректен\", function () {",
                  "    pm.response.to.have.header(\"Content-Type\");",
                  "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
                  "});",
                  "",
                  "pm.test(\"Тело ответа содержит JSON объект\", function () {",
                  "    pm.response.to.be.json;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
